{
    admin off
}

(security) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        -Server
    }
}

hanling.local {
    import security
    encode zstd gzip

    log {
        output stdout
        format json
    }

    handle /auth/* {
        reverse_proxy auth_service:8000 {
            health_uri /auth/ready
            health_interval 10s
            health_timeout 2s
            health_status 2xx
        }
    }

    handle {
        respond "HanLing API Gateway is running." 200
    }
}
